<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SKINARMA Saido 系列 - 復仇者3C配件</title>
    <style>
        :root {
            --bg-dark: #0f1115;
            --card-bg: #1c1f26;
            --accent-neon: #00f0ff;
            --text-main: #ffffff;
            --text-sub: #cbd5e1;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 400px;
            width: 100%;
            margin: 0 auto;
            padding: 15px;
            box-sizing: border-box;
        }

        h1 {
            font-size: 18px;
            margin: 15px 0 5px 0;
            text-align: center;
            color: var(--accent-neon);
        }

        .subtitle {
            font-size: 13px;
            color: var(--text-sub);
            text-align: center;
            margin-bottom: 20px;
        }

        /* 顏色展示區格線 (2欄) */
        .color-section {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 25px;
        }

        .color-card {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-neon);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.15);
            text-align: center;
            padding-bottom: 8px;
        }

        .color-card img {
            width: 100%;
            height: auto;
            display: block;
        }

        .color-title {
            font-size: 12px;
            color: var(--text-main);
            margin-top: 8px;
            font-weight: bold;
        }

        /* 官方長圖展示區 */
        .detail-img-container {
            width: 100%;
            background-color: var(--card-bg);
            border: 2px solid var(--accent-neon);
            border-radius: 12px;
            overflow: hidden;
            box-sizing: border-box;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
            margin-bottom: 25px;
        }

        .detail-img-container img {
            width: 100%;
            height: auto;
            display: block;
        }

        .back-section {
            text-align: center;
            margin-bottom: 40px;
        }

        .back-btn {
            display: inline-block;
            padding: 10px 25px;
            border: 2px solid var(--accent-neon);
            color: var(--accent-neon);
            text-decoration: none;
            border-radius: 20px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background-color: var(--accent-neon);
            color: var(--bg-dark);
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>SKINARMA Saido 磁吸基本款</h1>
        <div class="subtitle">潮流透明防摔系列</div>

        <!-- 顏色實拍展示區 (2欄排版) -->
        <div class="color-section">
            <div class="color-card">
                <img src="IMG_3629.webp" alt="墨灰色正面">
                <div class="color-title">墨灰色 (正面)</div>
            </div>
            <div class="color-card">
                <img src="IMG_4432.webp" alt="墨灰色側面">
                <div class="color-title">墨灰色 (側面)</div>
            </div>
            <div class="color-card">
                <img src="IMG_3630.webp" alt="透明色正面">
                <div class="color-title">透明色 (正面)</div>
            </div>
            <div class="color-card">
                <img src="IMG_4433.webp" alt="透明色側面">
                <div class="color-title">透明色 (側面)</div>
            </div>
        </div>

        <!-- 官方長圖特色介紹區 -->
        <div class="detail-img-container">
            <img src="IMG_3749.jpeg" alt="SKINARMA Saido 官方功能長圖">
        </div>

        <div class="back-section">
            <a href="skinarma18procase.html" class="back-btn">&larr; 返回系列選擇</a>
        </div>
    </div>

</body>
</html>

